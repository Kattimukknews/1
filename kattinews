            const evidenceUrl = document.getElementById('formEvidenceUrl').value.trim();

            const newReport = {
                id: 'report-' + Date.now(),
                headline,
                category,
                reporter,
                content,
                imageUrl: imageUrl || null,
                evidenceUrl: evidenceUrl || null,
                status: 'UNVERIFIED',
                published: false,
                timestamp: new Date().toISOString()
            };

            window.saveNewsToStorage(newReport);

            document.getElementById('newsForm').reset();
            document.getElementById('formReporter').disabled = false;

            alert("REPORT RECEIVED!\n\nYour news report has been forwarded to the KAATTIMUKKU Editorial & Verification Department.");
            navigateTo('home');
        }

        function toggleAdminModal() {
            if (window.isAdminLoggedIn) {
                navigateTo('admin');
            } else {
                document.getElementById('adminModal').classList.toggle('hidden');
            }
        }

        function verifyAdminPasskey() {
            const key = document.getElementById('adminPasskeyInput').value;
            if (key === 'PVIJAYAN' || key === 'VDSATHEESAN') {
                window.isAdminLoggedIn = true;
                localStorage.setItem('kaattimukku_admin', 'true');
                document.getElementById('adminModal').classList.add('hidden');
                document.getElementById('adminPasskeyInput').value = '';
                updateAdminUI();
                navigateTo('admin');
            } else {
                alert('Invalid Editorial Passkey. Access Denied.');
            }
        }

        function logoutAdmin() {
            window.isAdminLoggedIn = false;
            localStorage.setItem('kaattimukku_admin', 'false');
            updateAdminUI();
            navigateTo('home');
        }

        function updateAdminUI() {
            const btnText = document.getElementById('adminBtnText');
            const badge = document.getElementById('adminBadge');
            const icon = document.getElementById('adminIcon');

            if (window.isAdminLoggedIn) {
                btnText.innerText = 'Editorial Desk (Active)';
                badge.classList.remove('hidden');
                icon.className = 'fa-solid fa-unlock text-amber-600';
            } else {
                btnText.innerText = 'Editorial Desk';
                badge.classList.add('hidden');
                icon.className = 'fa-solid fa-lock text-slate-500';
            }
        }

        function switchAdminTab(tab) {
            activeAdminTab = tab;
            const pendingQueue = document.getElementById('adminPendingQueue');
            const publishedQueue = document.getElementById('adminPublishedQueue');
            const btnPending = document.getElementById('tabBtnPending');
            const btnPublished = document.getElementById('tabBtnPublished');

            if (tab === 'pending') {
                pendingQueue.classList.remove('hidden');
                publishedQueue.classList.add('hidden');
                btnPending.classList.add('border-red-900', 'text-red-900');
                btnPending.classList.remove('border-transparent', 'text-slate-500');
                btnPublished.classList.remove('border-red-900', 'text-red-900');
                btnPublished.classList.add('border-transparent', 'text-slate-500');
            } else {
                pendingQueue.classList.add('hidden');
                publishedQueue.classList.remove('hidden');
                btnPublished.classList.add('border-red-900', 'text-red-900');
                btnPublished.classList.remove('border-transparent', 'text-slate-500');
                btnPending.classList.remove('border-red-900', 'text-red-900');
                btnPending.classList.add('border-transparent', 'text-slate-500');
            }
        }

        function renderAdminDashboard() {
            if (!window.isAdminLoggedIn) {
                navigateTo('home');
                return;
            }

            const pendingItems = (window.allNews || []).filter(n => !n.published && n.status !== 'REJECTED');
            const publishedItems = (window.allNews || []).filter(n => n.published === true);
            const investigatingItems = (window.allNews || []).filter(n => n.status === 'UNDER_INVESTIGATION');
            const rejectedItems = (window.allNews || []).filter(n => n.status === 'REJECTED');

            document.getElementById('statPending').innerText = pendingItems.length;
            document.getElementById('statPublished').innerText = publishedItems.length;
            document.getElementById('statInvestigating').innerText = investigatingItems.length;
            document.getElementById('statRejected').innerText = rejectedItems.length;
            document.getElementById('statTotal').innerText = (window.allNews || []).length;

            document.getElementById('pendingTabCount').innerText = pendingItems.length;
            document.getElementById('publishedTabCount').innerText = publishedItems.length;

            const pendingContainer = document.getElementById('adminPendingQueue');
            if (pendingItems.length === 0) {
                pendingContainer.innerHTML = `<div class="p-6 text-center text-slate-500 text-xs">No pending reports awaiting verification.</div>`;
            } else {
                pendingContainer.innerHTML = pendingItems.map(item => `
                    <div class="p-4 bg-slate-50/80 border border-slate-200/80 rounded-xl flex flex-col md:flex-row justify-between gap-4 transition hover:bg-slate-50">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-1">
                                <span class="font-bold text-red-900">${escapeHtml(item.category)}</span>
                                <span>•</span>
                                <span>By ${escapeHtml(item.reporter || 'Anonymous')}</span>
                                <span>•</span>
                                <span>${formatDate(item.timestamp)}</span>
                            </div>
                            <h4 class="font-headline font-bold text-base text-slate-900 mb-2">${escapeHtml(item.headline)}</h4>
                            <p class="text-xs text-slate-600 line-clamp-2">${escapeHtml(item.content)}</p>
                        </div>
                        <div class="flex flex-wrap md:flex-col justify-end gap-1.5 border-t md:border-t-0 md:border-l border-slate-200 pt-3 md:pt-0 md:pl-4 min-w-[160px]">
                            <button onclick="adminApproveAndPublish('${item.id}')" class="px-3 py-1.5 bg-emerald-700 text-white text-[11px] font-bold rounded-lg hover:bg-emerald-800 transition">
                                ✓ Verify & Publish
                            </button>
                            <button onclick="adminMarkInvestigating('${item.id}')" class="px-3 py-1.5 bg-amber-600 text-white text-[11px] font-bold rounded-lg hover:bg-amber-700 transition">
                                🟡 Investigate
                            </button>
                            <button onclick="adminReject('${item.id}')" class="px-3 py-1.5 bg-rose-700 text-white text-[11px] font-bold rounded-lg hover:bg-rose-800 transition">
                                ✕ Reject
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            const publishedContainer = document.getElementById('adminPublishedQueue');
            if (publishedItems.length === 0) {
                publishedContainer.innerHTML = `<div class="p-6 text-center text-slate-500 text-xs">No published news reports yet.</div>`;
            } else {
                publishedContainer.innerHTML = publishedItems.map(item => `
                    <div class="p-4 bg-white border border-slate-200/80 rounded-xl flex flex-col md:flex-row justify-between gap-4 transition hover:border-slate-300">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-1">
                                ${getStatusBadgeHtml(item.status)}
                                <span class="font-bold text-slate-700">${escapeHtml(item.category)}</span>
                            </div>
                            <h4 class="font-headline font-bold text-base text-slate-900 mb-1">${escapeHtml(item.headline)}</h4>
                            <p class="text-xs text-slate-600 line-clamp-1">${escapeHtml(item.content)}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="openEditModal('${item.id}')" class="px-3 py-1.5 border border-slate-300 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-100 transition">
                                <i class="fa-solid fa-pen mr-1"></i> Edit
                            </button>
                            <button onclick="adminUnpublish('${item.id}')" class="px-3 py-1.5 border border-amber-300 text-amber-800 bg-amber-50 text-xs font-bold rounded-lg hover:bg-amber-100 transition">
                                Unpublish
                            </button>
                            <button onclick="adminDelete('${item.id}')" class="px-3 py-1.5 border border-rose-300 text-rose-800 bg-rose-50 text-xs font-bold rounded-lg hover:bg-rose-100 transition">
                                Delete
                            </button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function adminApproveAndPublish(id) {
            const article = window.allNews.find(n => n.id === id);
            if (!article) return;
            article.published = true;
            article.status = 'VERIFIED';
            window.saveNewsToStorage(article);
        }

        function adminMarkInvestigating(id) {
            const article = window.allNews.find(n => n.id === id);
            if (!article) return;
            article.published = true;
            article.status = 'UNDER_INVESTIGATION';
            window.saveNewsToStorage(article);
        }

        function adminReject(id) {
            const article = window.allNews.find(n => n.id === id);
            if (!article) return;
            article.published = false;
            article.status = 'REJECTED';
            window.saveNewsToStorage(article);
        }

        function adminUnpublish(id) {
            const article = window.allNews.find(n => n.id === id);
            if (!article) return;
            article.published = false;
            window.saveNewsToStorage(article);
        }

        function adminDelete(id) {
            if (confirm('Are you sure you want to permanently delete this report?')) {
                window.deleteNewsFromStorage(id);
            }
        }

        function openEditModal(id) {
            const article = window.allNews.find(n => n.id === id);
            if (!article) return;

            document.getElementById('editArticleId').value = article.id;
            document.getElementById('editHeadline').value = article.headline;
            document.getElementById('editCategory').value = article.category || 'AWARDS';
            document.getElementById('editStatus').value = article.status || 'VERIFIED';
            document.getElementById('editReporter').value = article.reporter || '';
            document.getElementById('editContent').value = article.content;

            document.getElementById('editArticleModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editArticleModal').classList.add('hidden');
        }

        function saveArticleEdit(e) {
            e.preventDefault();
            const id = document.getElementById('editArticleId').value;
            const article = window.allNews.find(n => n.id === id);

            if (article) {
                article.headline = document.getElementById('editHeadline').value.trim();
                article.category = document.getElementById('editCategory').value;
                article.status = document.getElementById('editStatus').value;
                article.reporter = document.getElementById('editReporter').value.trim();
                article.content = document.getElementById('editContent').value.trim();

                window.saveNewsToStorage(article);
            }

            closeEditModal();
        }

        function getStatusBadgeHtml(status) {
            if (status === 'VERIFIED') {
                return `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">🟢 VERIFIED</span>`;
            } else if (status === 'UNDER_INVESTIGATION') {
                return `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300">🟡 UNDER INVESTIGATION</span>`;
            } else {
                return `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-300">🔴 UNVERIFIED</span>`;
            }
        }

        function formatDate(ts) {
            if (!ts) return 'Recent';
            const d = new Date(ts);
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
