<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KAATTIMUKKU NEWS — 100% Professional. Real. Verified.</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Playfair Display for editorial serif, Inter for UI, Noto Sans Malayalam -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+Malayalam:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            red: '#850000',
                            darkred: '#5e0000',
                            navy: '#0f172a',
                            slate: '#1e293b',
                            gold: '#b45309',
                            paper: '#fcfbf7',
                            card: '#ffffff'
                        }
                    },
                    fontFamily: {
                        serif: ['"Playfair Display"', 'Georgia', 'serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        malayalam: ['"Noto Sans Malayalam"', 'sans-serif']
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(8px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' }
                        },
                        pulseGlow: {
                            '0%, 100%': { opacity: '1', transform: 'scale(1)' },
                            '50%': { opacity: '0.6', transform: 'scale(1.15)' }
                        }
                    },
                    animation: {
                        fadeIn: 'fadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        pulseGlow: 'pulseGlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', 'Noto Sans Malayalam', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        .font-headline {
            font-family: 'Playfair Display', 'Noto Sans Malayalam', serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .paper-texture {
            background-color: #fafaf9;
            background-image: radial-gradient(#e2e8f0 0.6px, transparent 0.6px);
            background-size: 20px 20px;
        }
        .nav-btn {
            position: relative;
            transition: all 0.2s ease;
        }
        .nav-btn::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            width: 0;
            height: 2px;
            background-color: #850000;
            transition: all 0.25s ease;
            transform: translateX(-50%);
            border-radius: 2px;
        }
        .nav-btn.active::after, .nav-btn:hover::after {
            width: 80%;
        }
        .news-card {
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .news-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -8px rgba(15, 23, 42, 0.12);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col paper-texture text-slate-900 antialiased selection:bg-red-900 selection:text-white">

    <!-- Top Announcement Bar -->
    <div class="bg-slate-950 text-slate-200 text-xs py-2 px-4 border-b border-slate-800 shadow-inner">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-2 font-medium tracking-wide">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-600 animate-pulseGlow"></span>
                <span class="text-amber-400 uppercase tracking-widest text-[10px] font-bold">WELCOME TO KATTIMUKK NEWS:</span>
                <span id="tickerText" class="truncate max-w-md sm:max-w-xl text-slate-300">मोइदू जी हमारी कृपा हैं</span>
            </div>
            <div class="flex items-center gap-4 text-[11px] text-slate-400 font-mono">
                <span id="liveDate">Wednesday, Sept 23, 2026</span>
                <span class="hidden md:inline text-slate-700">|</span>
                <span class="hidden md:inline text-amber-500 font-semibold flex items-center gap-1">
                    <i class="fa-regular fa-clock text-[10px]"></i>
                    <span id="ist-clock">00:00:00 PM IST</span>
                </span>
            </div>
        </div>
    </div>

    <script>
        function updateLiveDateTime() {
            const now = new Date();
            const dateOptions = { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' };
            document.getElementById('liveDate').textContent = now.toLocaleDateString('en-US', dateOptions);

            const timeOptions = { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
            const timeString = now.toLocaleTimeString('en-US', timeOptions);
            document.getElementById('ist-clock').textContent = `${timeString} IST`;
        }
        setInterval(updateLiveDateTime, 1000);
        updateLiveDateTime();
    </script>

    <!-- Header & Navigation -->
    <header class="border-b-4 border-slate-950 bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-40 transition-all">
        <div class="max-w-7xl mx-auto px-4 py-5 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                
                <div class="w-full md:w-1/4 flex items-center justify-start gap-2 text-xs">
                    <button onclick="toggleAdminModal()" id="adminStatusBtn" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 border border-slate-300/80 font-mono text-slate-700 transition-all duration-200 flex items-center gap-2 hover:shadow-sm">
                        <i class="fa-solid fa-user-shield text-slate-500" id="adminIcon"></i>
                        <span id="adminBtnText" class="font-medium">Editorial Desk</span>
                    </button>
                    <span id="adminBadge" class="hidden px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-300 animate-pulse">
                        ADMIN ACTIVE
                    </span>
                </div>

                <div class="text-center flex-1">
                    <a href="#" onclick="navigateTo('home'); return false;" class="inline-block group">
                        <h1 class="font-headline text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-slate-950 uppercase group-hover:text-red-900 transition-colors duration-200">
                            KAATTIMUKKU NEWS
                        </h1>
                        <p class="font-serif italic text-xs sm:text-sm font-semibold tracking-widest text-red-800 mt-1 uppercase border-t border-b border-red-200/80 py-0.5 inline-block px-6">
                            വാർത്തയിൽ വസ്തുത, വാക്കിൽ വ്യക്തത
                        </p>
                    </a>
                </div>

                <div class="w-full md:w-1/4 flex items-center justify-end">
                    <button onclick="navigateTo('submit')" class="w-full sm:w-auto px-5 py-2.5 bg-red-900 hover:bg-red-950 active:scale-95 text-white font-bold text-xs tracking-wider uppercase rounded-lg shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 border border-red-950">
                        <i class="fa-solid fa-plus-circle text-sm"></i>
                        <span>+ Post New News</span>
                    </button>
                </div>
            </div>

            <nav class="mt-5 pt-3 border-t border-slate-200/80 overflow-x-auto">
                <div class="flex items-center justify-center min-w-max space-x-1 sm:space-x-4 text-xs font-bold uppercase tracking-wider text-slate-700">
                    <button onclick="navigateTo('home')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition" data-target="home">Home</button>
                    <button onclick="filterCategory('LATEST')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition">Latest</button>
                    <button onclick="filterCategory('BREAKING')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition">Breaking</button>
                    <button onclick="filterCategory('AWARDS')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition">AWARDS</button>
                    <button onclick="filterCategory('Development')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition">Development</button>
                    <button onclick="filterCategory('Events')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition">Events</button>
                    <button onclick="navigateTo('investigation')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition text-amber-900 bg-amber-50/80 border border-amber-200/60" data-target="investigation">
                        <i class="fa-solid fa-magnifying-glass mr-1.5"></i>Investigation
                    </button>
                    <button onclick="navigateTo('evidence')" class="nav-link nav-btn px-3 py-1.5 hover:text-red-900 rounded transition" data-target="evidence">Evidence</button>
                </div>
            </nav>
        </div>
    </header>

    <!-- Search & Filter Ribbon -->
    <section class="bg-slate-100/80 backdrop-blur border-b border-slate-200 py-3 px-4">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row gap-3 items-center justify-between">
            <div class="relative w-full md:w-96">
                <i class="fa-solid fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="searchInput" onkeyup="handleSearch()" placeholder="Search headlines, reports, reporters..." class="w-full pl-9 pr-4 py-1.5 text-xs bg-white border border-slate-300/80 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-900/30 focus:border-red-800 transition">
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto text-xs">
                <span class="text-slate-500 font-semibold whitespace-nowrap text-[11px] uppercase tracking-wide">Status:</span>
                <button onclick="filterStatus('ALL')" class="status-filter-btn px-3 py-1 rounded-full border border-slate-300 bg-white hover:bg-slate-50 font-medium active text-slate-800 transition">All</button>
                <button onclick="filterStatus('VERIFIED')" class="status-filter-btn px-3 py-1 rounded-full border border-emerald-300 bg-emerald-50 text-emerald-900 hover:bg-emerald-100 font-medium transition">🟢 Verified</button>
                <button onclick="filterStatus('UNDER_INVESTIGATION')" class="status-filter-btn px-3 py-1 rounded-full border border-amber-300 bg-amber-50 text-amber-900 hover:bg-amber-100 font-medium transition">🟡 Investigating</button>
                <button onclick="filterStatus('UNVERIFIED')" class="status-filter-btn px-3 py-1 rounded-full border border-rose-300 bg-rose-50 text-rose-900 hover:bg-rose-100 font-medium transition">🔴 Unverified</button>
            </div>
        </div>
    </section>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8 sm:px-6 lg:px-8">
        
        <!-- Home View -->
        <div id="view-home" class="view-section animate-fadeIn">
            <div id="breakingBannerContainer" class="mb-8 hidden"></div>

            <div class="flex items-center justify-between border-b-2 border-slate-950 pb-2.5 mb-6">
                <h2 class="font-headline text-2xl font-black uppercase text-slate-950 tracking-tight flex items-center gap-2.5">
                    <span class="w-3 h-3 bg-red-800 inline-block rounded-sm"></span>
                    Published Reports
                </h2>
                <span id="newsCountBadge" class="text-xs font-mono bg-slate-200/80 text-slate-700 px-2.5 py-1 rounded-md border border-slate-300/50 font-semibold">0 Stories Published</span>
            </div>

            <div id="newsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>

            <div id="emptyNewsState" class="hidden text-center py-16 bg-white border border-dashed border-slate-300 rounded-xl shadow-sm p-8 max-w-2xl mx-auto animate-fadeIn">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
                    <i class="fa-solid fa-newspaper text-2xl"></i>
                </div>
                <h3 class="font-headline text-2xl font-bold text-slate-800 mb-2">No Published Reports Found</h3>
                <p class="text-slate-600 text-sm mb-6 max-w-md mx-auto">
                    The editorial desk currently has zero published reports matching your criteria. Be the first citizen journalist to submit a report for verification.
                </p>
                <button onclick="navigateTo('submit')" class="px-6 py-2.5 bg-red-900 hover:bg-red-950 text-white font-bold text-xs uppercase tracking-wider rounded-lg transition shadow">
                    + Post New News
                </button>
            </div>
        </div>

        <!-- Submit News View -->
        <div id="view-submit" class="view-section hidden max-w-3xl mx-auto animate-fadeIn">
            <div class="bg-white border border-slate-300/80 rounded-xl shadow-lg p-6 sm:p-8">
                <div class="border-b border-slate-200 pb-4 mb-6">
                    <span class="text-xs font-mono uppercase tracking-widest text-red-800 font-bold">Public Dispatch Form</span>
                    <h2 class="font-headline text-3xl font-black text-slate-950 mt-1">Submit News Report</h2>
                    <p class="text-xs text-slate-500 mt-1">Your report will be forwarded to the KAATTIMUKKU Editorial & Verification Department for swift scrutiny.</p>
                </div>

                <form id="newsForm" onsubmit="handleFormSubmit(event)" class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-800 mb-1.5">
                            News Headline <span class="text-red-700">*</span>
                        </label>
                        <input type="text" id="formHeadline" required placeholder="e.g. CLASSROOM FAN STOPS WORKING FOR 11 MINUTES" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-red-900/30 focus:border-red-900 focus:outline-none transition">
                        <p class="text-[11px] text-slate-500 mt-1">Keep it serious and factual. Supports English & Malayalam text.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-800 mb-1.5">
                                Category <span class="text-red-700">*</span>
                            </label>
                            <select id="formCategory" required class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-red-900/30 focus:border-red-900 focus:outline-none transition">
                                <option value="AWARDS">AWARDS</option>
                                <option value="Breaking News">Breaking News</option>
                                <option value="Development">Development</option>
                                <option value="Academics">Academics</option>
                                <option value="Events">Events</option>
                                <option value="Sports">Sports</option>
                                <option value="Student Life">Student Life</option>
                                <option value="Investigation">Investigation</option>
                                <option value="Fake News">Fake News</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-800 mb-1.5">
                                Reporter Credit
                            </label>
                            <input type="text" id="formReporter" placeholder="Reporter Name / Class" class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-red-900/30 focus:border-red-900 focus:outline-none transition">
                            <div class="mt-2.5 flex items-center">
                                <input type="checkbox" id="formAnon" onchange="toggleAnonReporter(this)" class="rounded text-red-900 focus:ring-red-800 h-4 w-4 border-slate-300 cursor-pointer">
                                <label for="formAnon" class="ml-2 text-xs text-slate-600 cursor-pointer">Submit Anonymously ("Anonymous Citizen")</label>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-800 mb-1.5">
                            Full News Report <span class="text-red-700">*</span>
                        </label>
                        <textarea id="formContent" required rows="6" placeholder="Provide detailed facts. Supports Malayalam (മലയാളം) typing." class="w-full px-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-lg focus:bg-white focus:ring-2 focus:ring-red-900/30 focus:border-red-900 focus:outline-none font-sans transition"></textarea>
                    </div>

                    <div class="p-4 bg-slate-50/80 border border-slate-200 rounded-lg space-y-4">
                        <div>
                            <span class="block text-xs font-bold uppercase tracking-wider text-slate-900">
                                Evidence & Supporting Material
                            </span>
                            <span class="text-[11px] text-slate-500 italic block mt-0.5">
                                “Because allegations alone are apparently insufficient.”
                            </span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Image URL (Optional)</label>
                                <input type="url" id="formImageUrl" placeholder="https://..." class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-md focus:ring-1 focus:ring-red-900 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-[11px] font-semibold text-slate-700 mb-1">External Link / Video / Doc URL</label>
                                <input type="url" id="formEvidenceUrl" placeholder="https://..." class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-md focus:ring-1 focus:ring-red-900 focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="pt-2 flex justify-end gap-3">
                        <button type="button" onclick="navigateTo('home')" class="px-5 py-2.5 border border-slate-300 text-slate-700 text-xs font-bold uppercase rounded-lg hover:bg-slate-100 transition">
                            Cancel
                        </button>
                        <button type="submit" class="px-6 py-2.5 bg-red-900 hover:bg-red-950 active:scale-95 text-white font-bold text-xs uppercase tracking-wider rounded-lg shadow transition flex items-center gap-2">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>Submit for Verification</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Single Article Detail View -->
        <div id="view-article" class="view-section hidden max-w-4xl mx-auto animate-fadeIn">
            <div id="articleContainer"></div>
        </div>

        <!-- Investigation Bureau View -->
        <div id="view-investigation" class="view-section hidden max-w-5xl mx-auto animate-fadeIn">
            <div class="bg-slate-950 text-white p-6 sm:p-8 rounded-xl shadow-2xl border border-slate-800 mb-8">
                <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 border-b border-slate-800 pb-6">
                    <div>
                        <span class="text-xs font-mono text-amber-500 uppercase tracking-widest font-bold">Special Bureau Division</span>
                        <h2 class="font-headline text-3xl font-black tracking-tight text-white mt-1">🔎 KAATTIMUKKU INVESTIGATION DESK</h2>
                        <p class="text-xs text-slate-400 mt-1 italic">“Our highly trained team is looking into it. Probably.”</p>
                    </div>
                    <div class="bg-slate-900/90 px-5 py-2.5 rounded-lg border border-slate-800 text-right">
                        <span class="block text-[10px] font-mono uppercase text-slate-400 tracking-wider">Active Dossiers</span>
                        <span id="activeCasesCount" class="text-2xl font-mono font-bold text-amber-400">0</span>
                    </div>
                </div>

                <div id="investigationList" class="mt-6 space-y-4"></div>
            </div>
        </div>

        <!-- Evidence Vault View -->
        <div id="view-evidence" class="view-section hidden animate-fadeIn">
            <div class="border-b border-slate-300 pb-4 mb-6">
                <h2 class="font-headline text-3xl font-black text-slate-950">Evidence Vault & Attachments</h2>
                <p class="text-xs text-slate-600 mt-1">Photographic and documentary materials submitted by witnesses to corroborate reported claims.</p>
            </div>

            <div id="evidenceGalleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
        </div>

        <!-- Admin Control Desk View -->
        <div id="view-admin" class="view-section hidden animate-fadeIn">
            <div class="bg-white border border-slate-300/80 rounded-xl shadow-md p-6 mb-8">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-slate-200 pb-4 mb-6 gap-4">
                    <div>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-900 border border-red-200 uppercase tracking-wider">Restricted Access</span>
                        <h2 class="font-headline text-3xl font-black text-slate-950 mt-1">KAATTIMUKKU Editorial Desk</h2>
                        <p class="text-xs text-slate-500">Manage submissions, verify statements, edit live text, and control public distribution.</p>
                    </div>
                    <button onclick="logoutAdmin()" class="text-xs px-3.5 py-1.5 border border-slate-300 rounded-lg hover:bg-slate-100 font-semibold text-slate-700 transition">
                        <i class="fa-solid fa-lock mr-1.5"></i> Exit Admin Mode
                    </button>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
                    <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-lg text-center shadow-sm">
                        <span class="block text-2xl font-mono font-bold text-amber-600" id="statPending">0</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Pending Review</span>
                    </div>
                    <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-lg text-center shadow-sm">
                        <span class="block text-2xl font-mono font-bold text-emerald-600" id="statPublished">0</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Published</span>
                    </div>
                    <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-lg text-center shadow-sm">
                        <span class="block text-2xl font-mono font-bold text-amber-500" id="statInvestigating">0</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Investigating</span>
                    </div>
                    <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-lg text-center shadow-sm">
                        <span class="block text-2xl font-mono font-bold text-rose-600" id="statRejected">0</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Rejected</span>
                    </div>
                    <div class="p-4 bg-slate-50 border border-slate-200/80 rounded-lg text-center shadow-sm col-span-2 md:col-span-1">
                        <span class="block text-2xl font-mono font-bold text-slate-800" id="statTotal">0</span>
                        <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Total Filed</span>
                    </div>
                </div>

                <div class="flex border-b border-slate-200 mb-6 text-xs font-bold uppercase tracking-wider space-x-6">
                    <button onclick="switchAdminTab('pending')" id="tabBtnPending" class="pb-2 border-b-2 border-red-900 text-red-900 transition-all">Pending Queue (<span id="pendingTabCount">0</span>)</button>
