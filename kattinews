                    </div>
                `;
                return;
            }

            list.innerHTML = cases.map((item, idx) => `
                <div class="bg-slate-900/80 border border-slate-800 rounded-lg p-5 text-slate-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:border-slate-700 transition">
                    <div>
                        <div class="flex items-center gap-2 text-xs font-mono text-amber-400 mb-1">
                            <span class="font-bold">CASE #${String(idx + 101).padStart(4, '0')}</span>
                            <span>•</span>
                            <span>STATUS: ACTIVE INVESTIGATION</span>
                        </div>
                        <h4 class="font-headline text-lg font-bold text-white hover:text-amber-300 cursor-pointer transition-colors" onclick="navigateTo('article', '${item.id}')">
                            ${escapeHtml(item.headline)}
                        </h4>
                        <p class="text-xs text-slate-400 mt-1 line-clamp-1">${escapeHtml(item.content)}</p>
                    </div>
                    <button onclick="navigateTo('article', '${item.id}')" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 active:scale-95 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg whitespace-nowrap transition shadow">
