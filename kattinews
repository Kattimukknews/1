                    <div class="border-b border-slate-200/80 pb-6 mb-6">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                            <span class="px-3 py-1 bg-red-100 text-red-950 font-mono text-xs font-bold rounded-md uppercase tracking-wider">
                                ${escapeHtml(article.category)}
                            </span>
                            ${getStatusBadgeHtml(article.status)}
                        </div>

                        <h1 class="font-headline text-3xl sm:text-5xl font-black text-slate-950 leading-tight mb-4">
                            ${escapeHtml(article.headline)}
                        </h1>

                        <div class="flex items-center gap-4 text-xs text-slate-500 font-mono">
                            <span>Filed by: <strong class="text-slate-800">${escapeHtml(article.reporter || 'Anonymous Citizen')}</strong></span>
                            <span>•</span>
                            <span>${formatDate(article.timestamp)}</span>
                        </div>
                    </div>

                    <div class="p-4 rounded-lg border mb-8 flex items-start gap-3 bg-slate-50/80 border-slate-200">
                        <div class="text-2xl mt-0.5">
                            ${article.status === 'VERIFIED' ? '🟢' : article.status === 'UNDER_INVESTIGATION' ? '🟡' : '🔴'}
                        </div>
                        <div>
                            <h4 class="font-bold text-xs uppercase tracking-wider text-slate-900">
                                Official Verification Status: ${article.status || 'UNVERIFIED'}
                            </h4>
                            <p class="text-xs text-slate-600 mt-0.5 italic">
                                ${article.status === 'VERIFIED' ? 'Verified by our completely unbiased and definitely real verification department.' : 
                                  article.status === 'UNDER_INVESTIGATION' ? 'Our highly trained team is currently examining witness testimonies.' : 
                                  'This report has not yet been corroborated by independent third-party bench witnesses.'}
                            </p>
                        </div>
                    </div>

                    ${article.imageUrl ? `
                        <div class="mb-8 rounded-xl overflow-hidden border border-slate-200 shadow-sm">
                            <img src="${escapeHtml(article.imageUrl)}" alt="Attached Evidence" class="w-full max-h-[450px] object-cover" onerror="this.style.display='none'">
                        </div>
                    ` : ''}

                    <div class="prose max-w-none text-slate-800 text-sm sm:text-base leading-relaxed whitespace-pre-line font-sans mb-8">
                        ${escapeHtml(article.content)}
                    </div>

                    ${(article.evidenceUrl || article.imageUrl) ? `
                        <div class="p-5 bg-amber-50/60 border border-amber-200/80 rounded-lg mt-8">
                            <h4 class="font-bold text-xs uppercase tracking-wider text-amber-950 mb-2 flex items-center gap-1.5">
                                <i class="fa-solid fa-paperclip text-amber-800"></i> 📰 കാട്ടിമുക്ക് ന്യൂസിനായി വാർത്തകൾ നൽകാം
                            </h4>
                            <p class="text-xs text-amber-900 mb-3 italic">⚠️ മുന്നറിയിപ്പ്: വ്യാജ വാർത്തകൾ നൽകുന്നത് ശിക്ഷാർഹമാണ്</p>
                            ${article.evidenceUrl ? `
                                <a href="${escapeHtml(article.evidenceUrl)}" target="_blank" rel="noopener" class="text-xs text-red-900 underline font-mono break-all hover:text-red-950 transition">
                                    <i class="fa-solid fa-external-link mr-1"></i> View Submitted External Material
                                </a>
                            ` : ''}
                        </div>
                    ` : ''}
                </div>
            `;
        }

        function renderInvestigationDesk() {
            const list = document.getElementById('investigationList');
            const countEl = document.getElementById('activeCasesCount');

            const cases = (window.allNews || []).filter(n => n.status === 'UNDER_INVESTIGATION');
            countEl.innerText = cases.length;

            if (cases.length === 0) {
                list.innerHTML = `
                    <div class="p-8 text-center text-slate-400 font-mono text-xs border border-dashed border-slate-800 rounded-lg">
