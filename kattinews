    <!-- Application Controller Logic (Local Storage Powered) -->
    <script>
        let currentView = 'home';
        let activeCategoryFilter = 'ALL';
        let activeStatusFilter = 'ALL';
        let searchQuery = '';
        let activeAdminTab = 'pending';

        window.allNews = JSON.parse(localStorage.getItem('kaattimukku_news_cache') || '[]');
        window.isAdminLoggedIn = localStorage.getItem('kaattimukku_admin') === 'true';

        window.saveNewsToStorage = function(newsItem) {
            const index = window.allNews.findIndex(n => n.id === newsItem.id);
            if (index >= 0) {
                window.allNews[index] = newsItem;
            } else {
                window.allNews.unshift(newsItem);
            }
            localStorage.setItem('kaattimukku_news_cache', JSON.stringify(window.allNews));
            window.renderCurrentView();
        };

        window.deleteNewsFromStorage = function(newsId) {
            window.allNews = window.allNews.filter(n => n.id !== newsId);
            localStorage.setItem('kaattimukku_news_cache', JSON.stringify(window.allNews));
            window.renderCurrentView();
        };

        window.onload = function() {
            const dateObj = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
            document.getElementById('liveDate').innerText = dateObj.toLocaleDateString('en-US', options);
            
            updateAdminUI();
            renderCurrentView();
        };

        function navigateTo(viewId, param = null) {
            currentView = viewId;
            document.querySelectorAll('.view-section').forEach(el => el.classList.add('hidden'));
            
            const targetEl = document.getElementById(`view-${viewId}`);
            if (targetEl) targetEl.classList.remove('hidden');

            document.querySelectorAll('.nav-link').forEach(btn => {
                if (btn.getAttribute('data-target') === viewId) {
                    btn.classList.add('active', 'text-red-900');
                } else {
                    btn.classList.remove('active', 'text-red-900');
                }
            });

            if (viewId === 'article' && param) {
                renderArticleDetail(param);
            } else {
                renderCurrentView();
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function filterCategory(cat) {
            activeCategoryFilter = cat;
            if (currentView !== 'home') navigateTo('home');
            else renderCurrentView();
        }

        function filterStatus(status) {
            activeStatusFilter = status;
            document.querySelectorAll('.status-filter-btn').forEach(btn => {
                if (btn.innerText.includes(status) || (status === 'ALL' && btn.innerText === 'All')) {
                    btn.classList.add('bg-slate-800', 'text-white', 'border-slate-800');
                } else {
                    btn.classList.remove('bg-slate-800', 'text-white', 'border-slate-800');
                }
            });
            renderCurrentView();
        }

        function handleSearch() {
            searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
            renderCurrentView();
        }

        window.renderCurrentView = function() {
            if (currentView === 'home') renderHomepage();
            else if (currentView === 'investigation') renderInvestigationDesk();
            else if (currentView === 'evidence') renderEvidenceGallery();
            else if (currentView === 'admin') renderAdminDashboard();
        };

        function renderHomepage() {
            const grid = document.getElementById('newsGrid');
            const emptyState = document.getElementById('emptyNewsState');
            const breakingContainer = document.getElementById('breakingBannerContainer');
            const newsCountBadge = document.getElementById('newsCountBadge');

            let publishedNews = (window.allNews || []).filter(item => item.published === true);

            if (activeCategoryFilter === 'BREAKING') {
                publishedNews = publishedNews.filter(n => n.category === 'Breaking News');
            } else if (activeCategoryFilter !== 'ALL' && activeCategoryFilter !== 'LATEST') {
                publishedNews = publishedNews.filter(n => n.category === activeCategoryFilter);
            }

            if (activeStatusFilter !== 'ALL') {
                publishedNews = publishedNews.filter(n => n.status === activeStatusFilter);
            }

            if (searchQuery) {
                publishedNews = publishedNews.filter(n => 
                    n.headline.toLowerCase().includes(searchQuery) ||
                    n.content.toLowerCase().includes(searchQuery) ||
                    (n.reporter && n.reporter.toLowerCase().includes(searchQuery))
                );
            }

            newsCountBadge.innerText = `${publishedNews.length} News Published`;

            if (publishedNews.length === 0) {
                grid.innerHTML = '';
                breakingContainer.innerHTML = '';
                breakingContainer.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            const breakingStory = publishedNews.find(n => n.category === 'Breaking News' || n.isBreaking);
            if (breakingStory && !searchQuery && activeCategoryFilter === 'ALL') {
                breakingContainer.classList.remove('hidden');
                breakingContainer.innerHTML = `
                    <div class="bg-red-950 text-white rounded-xl p-6 sm:p-8 shadow-xl border-l-8 border-red-600 relative overflow-hidden transition-all hover:shadow-2xl">
                        <div class="flex items-center gap-2 text-xs font-mono font-bold text-red-300 uppercase tracking-widest mb-2.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulseGlow"></span>
                            <span>🔴 BREAKING NEWS BULLETIN</span>
                        </div>
                        <h3 class="font-headline text-2xl sm:text-4xl font-black mb-3 leading-tight text-white cursor-pointer hover:underline" onclick="navigateTo('article', '${breakingStory.id}')">
                            ${escapeHtml(breakingStory.headline)}
                        </h3>
                        <p class="text-sm text-slate-200 line-clamp-2 mb-5 font-sans leading-relaxed">
                            ${escapeHtml(breakingStory.content)}
                        </p>
                        <div class="flex flex-wrap items-center justify-between gap-4 text-xs pt-4 border-t border-red-900/80 text-red-200 font-mono">
                            <div>
                                <span>Reporter: <strong class="text-white">${escapeHtml(breakingStory.reporter || 'Anonymous')}</strong></span>
                                <span class="mx-2 text-red-800">•</span>
                                <span>${formatDate(breakingStory.timestamp)}</span>
                            </div>
                            ${getStatusBadgeHtml(breakingStory.status)}
                        </div>
                    </div>
                `;
            } else {
                breakingContainer.innerHTML = '';
                breakingContainer.classList.add('hidden');
            }

            grid.innerHTML = publishedNews.map(item => `
                <article class="news-card bg-white border border-slate-200/80 rounded-xl shadow-sm hover:border-slate-300 transition-all flex flex-col justify-between overflow-hidden group">
                    <div>
                        ${item.imageUrl ? `
                            <div class="h-48 overflow-hidden bg-slate-100 relative">
                                <img src="${escapeHtml(item.imageUrl)}" alt="News image" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://placehold.co/600x400/1e293b/ffffff?text=EVIDENCE+IMAGE'">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            </div>
                        ` : ''}
                        
                        <div class="p-5">
                            <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-2.5">
                                <span class="font-bold text-red-900 uppercase tracking-wider bg-red-50 px-2 py-0.5 rounded border border-red-100">${escapeHtml(item.category || 'AWARDS')}</span>
                                <span>${formatDate(item.timestamp)}</span>
                            </div>

                            <h3 onclick="navigateTo('article', '${item.id}')" class="font-headline text-xl font-bold text-slate-950 hover:text-red-900 cursor-pointer mb-3 leading-snug transition-colors">
                                ${escapeHtml(item.headline)}
                            </h3>

                            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
                                ${escapeHtml(item.content)}
                            </p>
                        </div>
                    </div>

                    <div class="p-5 pt-0 border-t border-slate-100 mt-auto flex items-center justify-between text-xs pt-3.5">
                        <span class="text-slate-500 font-medium truncate max-w-[130px]">By ${escapeHtml(item.reporter || 'Anonymous')}</span>
                        ${getStatusBadgeHtml(item.status)}
                    </div>
                </article>
            `).join('');
        }

        function renderArticleDetail(articleId) {
            const article = (window.allNews || []).find(n => n.id === articleId);
            const container = document.getElementById('articleContainer');

            if (!article) {
                container.innerHTML = `<div class="p-8 text-center text-slate-600">Article not found or removed.</div>`;
                return;
            }

            container.innerHTML = `
                <div class="bg-white border border-slate-200/80 rounded-xl shadow-md p-6 sm:p-10">
                    <button onclick="navigateTo('home')" class="text-xs font-bold uppercase tracking-wider text-slate-500 hover:text-red-900 mb-6 flex items-center gap-2 transition">
                        <i class="fa-solid fa-arrow-left"></i> Back to Homepage
